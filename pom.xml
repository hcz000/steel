    <parent>
        <groupId>com.gv.steel</groupId>
        <artifactId>steel-common-bom</artifactId>
        <version>1.0.0</version>
        <relativePath>steel-common/steel-common-bom/pom.xml</relativePath>
    </parent>
</project>
