<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gv.steel.system.base.dao.MaterialQualityDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gv.steel.system.base.entity.MaterialQuality">
        <result column="id" property="id"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="delete_flag" property="deleteFlag"/>
        <result column="version" property="version"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="type" property="type"/>
        <result column="name" property="name"/>
        <result column="density" property="density"/>
        <result column="order_sort" property="orderSort"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        ,
                    create_by,
                    create_time,
                    update_by,
                    update_time,
                    delete_flag,
                    version,
                    tenant_id,
                type, name, density,order_sort
    </sql>
    <!-- 通用where查询条件 -->
    <sql id="where">
        <where>
            <if test="id != null and id != ''">
                and id = #{id}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
            <if test="deleteFlag != null and deleteFlag != ''">
                and delete_flag = #{deleteFlag}
            </if>
            <if test="version != null and version != ''">
                and version = #{version}
            </if>
            <if test="tenantId != null and tenantId != ''">
                and tenant_id = #{tenantId}
            </if>
        </where>
    </sql>
    <!-- 条件where查询条件 -->
    <sql id="condition">
        <where>
            <if test="type != null and type != ''">
                and type = #{type}
            </if>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
            <if test="density != null and density != ''">
                and density = #{density}
            </if>
            <if test="orderSort != null and orderSort != ''">
                and order_sort = #{orderSort}
            </if>
        </where>
    </sql>
    <select id="selectMaterialQualityList" resultType="com.gv.steel.system.base.entity.MaterialQuality">
        select tmq.id,
               tmq.type,
               COALESCE(tmql.label, tmq.name) as name,
               tmq.density,
               tmq.create_by,
               tmq.create_time,
               tmq.update_by,
               tmq.update_time,
               tmq.delete_flag,
               tmq.version,
               tmq.tenant_id,
               tmq.order_sort
        from t_material_quality tmq
                 left join t_material_quality_lang tmql
                           on tmq.id = tmql.material_quality_id
                               and tmql.lang = #{languageTag} and tmql.delete_flag = 0
        <where>
            and tmq.delete_flag = 0
        </where>
    </select>
</mapper>
