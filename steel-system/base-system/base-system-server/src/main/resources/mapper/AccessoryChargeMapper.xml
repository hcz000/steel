<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gv.steel.system.base.dao.AccessoryChargeDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gv.steel.system.base.entity.AccessoryCharge">
        <result column="id" property="id"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="delete_flag" property="deleteFlag"/>
        <result column="version" property="version"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="contract_id" property="contractId"/>
        <result column="charge_item" property="chargeItem"/>
        <result column="charge_way" property="chargeWay"/>
        <result column="unit" property="unit"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="use_scope" property="useScope"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        ,
                    create_by,
                    create_time,
                    update_by,
                    update_time,
                    delete_flag,
                    version,
                    tenant_id,
                contract_id, charge_item, charge_way, unit, unit_price, use_scope, remark
    </sql>
    <!-- 通用where查询条件 -->
    <sql id="where">
        <where>
            <if test="id != null and id != ''">
                and id = #{id}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
            <if test="deleteFlag != null and deleteFlag != ''">
                and delete_flag = #{deleteFlag}
            </if>
            <if test="version != null and version != ''">
                and version = #{version}
            </if>
            <if test="tenantId != null and tenantId != ''">
                and tenant_id = #{tenantId}
            </if>
        </where>
    </sql>
    <!-- 条件where查询条件 -->
    <sql id="condition">
        <where>
            <if test="contractId != null and contractId != ''">
                and contract_id = #{contractId}
            </if>
            <if test="chargeItem != null and chargeItem != ''">
                and charge_item = #{chargeItem}
            </if>
            <if test="chargeWay != null and chargeWay != ''">
                and charge_way = #{chargeWay}
            </if>
            <if test="unit != null and unit != ''">
                and unit = #{unit}
            </if>
            <if test="unitPrice != null and unitPrice != ''">
                and unit_price = #{unitPrice}
            </if>
            <if test="useScope != null and useScope != ''">
                and use_scope = #{useScope}
            </if>
            <if test="remark != null and remark != ''">
                and remark = #{remark}
            </if>
        </where>
    </sql>
    <select id="selectByCustomerIdAndUseScope" resultType="com.gv.steel.system.base.vo.ProcessAccessoryVO">
        select tac.id, tac.contract_id, tac.charge_way, tac.unit, tac.charge_item, tac.remark
        from t_processing_contract tpc
                 left join t_accessory_charge tac on tpc.id = tac.contract_id and tac.delete_flag = 0
        where tpc.customer_id = #{customerId}
          and tac.use_scope = #{useScope}
          and tpc.delete_flag = 0
    </select>
    <select id="selectAccessoryChargePage" resultType="com.gv.steel.system.base.vo.AccessoryChargePageVO">
        select tac.id, tcp.factory_id, tcp.customer_code, tac.charge_item, tac.charge_way, tac.unit, tac.unit_price,
        tac.use_scope, tac.remark, tac.unit_price, tpc.contract_no
        from t_accessory_charge tac
        join t_processing_contract tpc on tac.contract_id = tpc.id and tpc.delete_flag = 0
        join t_customer_profile tcp on tpc.customer_id = tcp.id and tcp.delete_flag = 0
        <where>
            and tac.delete_flag = 0
            <if test="param.factoryId != null">
                and tcp.factory_id = #{param.factoryId}
            </if>
            <if test="param.customerId != null">
                and tpc.customer_id = @{param.customerId}
            </if>
            <if test="param.contractNo != null and param.contractNo != ''">
                <bind name="contractNoLike" value="'%'+param.contractNo+'%'"/>
                and tpc.contract_no like #{contractNoLike}
            </if>
            <if test="param.chargeItem != null and param.chargeItem != ''">
                <bind name="chargeItemLike" value="'%'+param.chargeItem+'%'"/>
                and tac.charge_item like #{chargeItemLike}
            </if>
            <if test="param.chargeWay != null">
                and tac.charge_way = #{param.chargeWay}
            </if>
            <if test="param.useScope != null">
                and tac.use_scope = #{param.useScope}
            </if>
        </where>
        order by tpc.customer_id, tac.order_sort
    </select>
</mapper>
