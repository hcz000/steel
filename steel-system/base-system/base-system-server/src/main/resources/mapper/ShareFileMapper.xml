<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gv.steel.system.base.dao.ShareFileDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gv.steel.system.base.entity.ShareFile">
        <result column="id" property="id"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="delete_flag" property="deleteFlag"/>
        <result column="version" property="version"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="file_id" property="fileId"/>
        <result column="folder_id" property="folderId"/>
        <result column="attach_name" property="attachName"/>
        <result column="attach_suffix" property="attachSuffix"/>
        <result column="remark" property="remark"/>
        <result column="create_name" property="createName"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
                    create_by,
                    create_time,
                    update_by,
                    update_time,
                    delete_flag,
                    version,
                    tenant_id,
                file_id, folder_id, attach_name, attach_suffix, remark, create_name
    </sql>
    <!-- 通用where查询条件 -->
    <sql id="where">
        <where>
            <if test="id != null and id != ''">
                and id = #{id}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
            <if test="deleteFlag != null and deleteFlag != ''">
                and delete_flag = #{deleteFlag}
            </if>
            <if test="version != null and version != ''">
                and version = #{version}
            </if>
            <if test="tenantId != null and tenantId != ''">
                and tenant_id = #{tenantId}
            </if>
        </where>
    </sql>
    <!-- 条件where查询条件 -->
    <sql id="condition">
        <where>
            <if test="fileId != null and fileId != ''">
                and file_id = #{fileId}
            </if>
            <if test="folderId != null and folderId != ''">
                and folder_id = #{folderId}
            </if>
            <if test="attachName != null and attachName != ''">
                and attach_name = #{attachName}
            </if>
            <if test="attachSuffix != null and attachSuffix != ''">
                and attach_suffix = #{attachSuffix}
            </if>
            <if test="remark != null and remark != ''">
                and remark = #{remark}
            </if>
            <if test="createName != null and createName != ''">
                and create_name = #{createName}
            </if>
        </where>
    </sql>
    <select id="selectFileListByName" resultType="com.gv.steel.system.base.vo.FolderFileVO">
        select *
        from (
        select id, 0 as type, folder_name as name, null as file_id,
        null as file_type, null as file_size,
        parent_id_group as parent_ids, parent_name_group as parent_names,
        create_time, create_name
        from t_folder
        <where>
            and delete_flag = 0
            <if test="fileName != null and fileName != ''">
                <bind name="fileNameLike" value="'%'+fileName+'%'"/>
                and folder_name like #{fileNameLike}
            </if>
        </where>
        union all
        select id, 1 as type, attach_name as name, file_id,
        attach_type as file_type, attach_size as file_size,
        folder_id_group as parent_ids, folder_name_group as parent_names,
        create_time, create_name
        from t_share_file
        <where>
            and delete_flag = 0
            <if test="fileName != null and fileName != ''">
                <bind name="fileNameLike" value="'%'+fileName+'%'"/>
                and attach_name like #{fileNameLike}
            </if>
        </where>
        ) temp
        order by temp.create_time desc

    </select>
</mapper>
