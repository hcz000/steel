<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gv.steel.system.user.dao.SysFactoryDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gv.steel.system.user.entity.SysFactory">
        <result column="id" property="id"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="delete_flag" property="deleteFlag"/>
        <result column="version" property="version"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="factory_nickname" property="factoryNickname"/>
        <result column="factory_name" property="factoryName"/>
        <result column="address" property="address"/>
        <result column="factory_code" property="factoryCode"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        ,
                    create_by,
                    create_time,
                    update_by,
                    update_time,
                    delete_flag,
                    version,
                    tenant_id,
                factory_nickname, factory_name, address, factory_code, sort_order
    </sql>
    <!-- 通用where查询条件 -->
    <sql id="where">
        <where>
            <if test="id != null and id != ''">
                and id = #{id}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
            <if test="deleteFlag != null and deleteFlag != ''">
                and delete_flag = #{deleteFlag}
            </if>
            <if test="version != null and version != ''">
                and version = #{version}
            </if>
            <if test="tenantId != null and tenantId != ''">
                and tenant_id = #{tenantId}
            </if>
        </where>
    </sql>
    <!-- 条件where查询条件 -->
    <sql id="condition">
        <where>
            <if test="factoryNickname != null and factoryNickname != ''">
                and factory_nickname = #{factoryNickname}
            </if>
            <if test="factoryName != null and factoryName != ''">
                and factory_name = #{factoryName}
            </if>
            <if test="address != null and address != ''">
                and address = #{address}
            </if>
            <if test="factoryCode != null and factoryCode != ''">
                and factory_code = #{factoryCode}
            </if>
            <if test="sortOrder != null and sortOrder != ''">
                and sort_order = #{sortOrder}
            </if>
        </where>
    </sql>
    <select id="listFactoriesByUserId" resultType="com.gv.steel.system.user.entity.SysFactory">
        select *
        from sys_user_factory as suf
                 left join sys_factory as sf on sf.id = suf.factory_id
        where 1 = 1
          and sf.delete_flag = 0
          and suf.user_id = #{userId}
    </select>
</mapper>
