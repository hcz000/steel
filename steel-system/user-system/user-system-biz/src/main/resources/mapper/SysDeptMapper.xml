<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gv.steel.system.user.dao.SysDeptDao">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gv.steel.system.user.entity.SysDept">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="parent_id" property="parentId"/>
        <result column="create_time" property="createTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="delete_flag" property="deleteFlag"/>
    </resultMap>

    <!--关联查询部门列表-->
    <select id="listDepts" resultMap="BaseResultMap">
        SELECT t.id,
               t.name,
               t.sort_order,
               t.delete_flag,
               t.parent_id,
               t.create_time,
               t.create_by,
               t.update_time,
               t.update_by
        FROM sys_dept t
                 LEFT JOIN sys_dept_relation dr ON t.id = dr.descendant
        WHERE dr.ancestor = 0
    </select>
</mapper>
