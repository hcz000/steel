<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gv.steel.system.user.dao.SysUserTeamDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gv.steel.system.user.entity.SysUserTeam">
        <id column="user_id" property="userId"/>
        <result column="user_id" property="userId"/>
        <result column="factory_id" property="factoryId"/>
        <result column="team_id" property="teamId"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        user_id
        , factory_id, team_id
    </sql>
    <!-- 通用where查询条件 -->
    <sql id="where">
        <where>
        </where>
    </sql>
    <!-- 条件where查询条件 -->
    <sql id="condition">
        <where>
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="factoryId != null and factoryId != ''">
                and factory_id = #{factoryId}
            </if>
            <if test="teamId != null and teamId != ''">
                and team_id = #{teamId}
            </if>
        </where>
    </sql>
    <select id="listTeamIdsByUserId" resultType="java.lang.Long">
        select ut.team_id
        from sys_user_team as ut
        where 1 = 1
          and ut.user_id = #{userId}
    </select>
</mapper>
